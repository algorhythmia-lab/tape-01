---
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  modernize-use-nullptr
# Host/control enum underlying types are intentional ABI choices; do not shrink them for an advisory.
# pragma once is supported by every configured compiler (GCC, Clang, MSVC).
WarningsAsErrors: '*'
HeaderFilterRegex: '.*(libs|apps)/.*'
FormatStyle: file
...
