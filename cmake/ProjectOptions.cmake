include_guard(GLOBAL)

if(ALGORHYTHMIA_ENABLE_TSAN AND ALGORHYTHMIA_ENABLE_SANITIZERS)
    message(FATAL_ERROR "ThreadSanitizer and ASan need separate build trees")
endif()
function(algorhythmia_enable_sanitizers target)
    if(ALGORHYTHMIA_ENABLE_TSAN)
        if(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$" AND NOT CMAKE_CROSSCOMPILING)
            target_compile_options(${target} PRIVATE -fsanitize=thread -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=thread)
        else()
            message(FATAL_ERROR "TSan requires a native Clang or GCC build")
        endif()
    endif()
    if(ALGORHYTHMIA_ENABLE_SANITIZERS)
        get_target_property(already_enabled ${target} ALGORHYTHMIA_SANITIZERS_ENABLED)
        if(already_enabled)
            return()
        endif()
        if(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$" AND NOT CMAKE_CROSSCOMPILING)
            target_compile_options(${target} PRIVATE
                -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${target} PRIVATE
                -fsanitize=address,undefined -fno-sanitize-recover=all)
            set_property(TARGET ${target} PROPERTY ALGORHYTHMIA_SANITIZERS_ENABLED TRUE)
        else()
            message(FATAL_ERROR "Sanitizers require a native Clang or GCC host build")
        endif()
    endif()
endfunction()

function(algorhythmia_target_defaults target)
    target_compile_features(${target} PUBLIC cxx_std_20)
    if(ALGORHYTHMIA_ENABLE_CLANG_TIDY)
        set(tidy_command "${ALGORHYTHMIA_CLANG_TIDY}" --warnings-as-errors=*)
        if(APPLE)
            # Standalone LLVM tools do not discover Apple's libc++ include path.
            foreach(include_dir IN LISTS CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES)
                if(include_dir MATCHES "/c[+][+]/v1$")
                    list(APPEND tidy_command "--extra-arg=-isystem${include_dir}")
                endif()
            endforeach()
        endif()
        set_property(TARGET ${target} PROPERTY CXX_CLANG_TIDY "${tidy_command}")
    endif()
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /fp:strict)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$")
        # Preserve finite-value checks and predictable DSP arithmetic.
        target_compile_options(${target} PRIVATE
            -Wall -Wextra -Wpedantic -Werror -fno-fast-math -ffp-contract=off)
    else()
        message(FATAL_ERROR "Add explicit warning and floating-point policy for this compiler")
    endif()
    algorhythmia_enable_sanitizers(${target})
endfunction()
