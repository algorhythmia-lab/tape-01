#!/bin/bash
# SYS 01: verified, per-user installation. Generated for a specific release.
set -euo pipefail

TAG='@RELEASE_TAG@'
ARCHIVE_NAME='@ARCHIVE_NAME@'
ARCHIVE_SHA256='@ARCHIVE_SHA256@'
PAYLOAD='@PAYLOAD@'
BASE_URL="https://github.com/algorhythmia-lab/tape-01/releases/download/$TAG"
prefix="$HOME"
archive=''
dry_run=0

usage() {
    printf '%s\n' 'Usage: bash install-macos.sh [--dry-run] [--prefix ABSOLUTE_DIRECTORY] [--archive FILE]' \
        'Installs the app, VST3 and AU for the current user. No sudo is required.'
}
fail() { printf 'SYS 01: %s\n' "$*" >&2; exit 1; }
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) dry_run=1; shift ;;
        --prefix) [ "$#" -ge 2 ] || fail '--prefix needs a directory'; prefix="$2"; shift 2 ;;
        --archive) [ "$#" -ge 2 ] || fail '--archive needs a file'; archive="$2"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; fail "Unknown option: $1" ;;
    esac
done
[ "$(uname -s)" = Darwin ] || fail 'This download is for macOS.'
case "$(uname -m)" in arm64|x86_64) ;; *) fail 'An Apple silicon or Intel Mac is required.' ;; esac
major="$(/usr/bin/sw_vers -productVersion | cut -d. -f1)"
[ "$major" -ge 12 ] || fail 'macOS 12 or later is required.'
case "$prefix" in /*) ;; *) fail '--prefix must be an absolute path.' ;; esac
[ "$prefix" != / ] || fail 'The filesystem root is not an installation prefix.'

work="$(mktemp -d "${TMPDIR:-/tmp}/sys01-install.XXXXXX")"
targets=()
stages=()
backed_up=()
installed=()
committed=0
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    set +eu
    if [ "$committed" -eq 0 ]; then
        for ((i=${#targets[@]}-1; i>=0; i--)); do
            if [ "${installed[$i]:-0}" -eq 1 ]; then rm -rf "${targets[$i]}"; fi
            if [ "${backed_up[$i]:-0}" -eq 1 ]; then
                if ! mv "${stages[$i]}/previous" "${targets[$i]}"; then
                    printf 'Restore the previous SYS 01 from %s\n' "${stages[$i]}/previous" >&2
                    continue
                fi
            fi
            rm -rf "${stages[$i]}"
        done
    else
        for stage in "${stages[@]}"; do rm -rf "$stage"; done
    fi
    rm -rf "$work"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
if [ -z "$archive" ]; then
    archive="$work/$ARCHIVE_NAME"
    /usr/bin/curl --fail --location --proto '=https' --tlsv1.2 --retry 3 \
        "$BASE_URL/$ARCHIVE_NAME" --output "$archive"
fi
[ -f "$archive" ] || fail "Archive not found: $archive"
actual="$(/usr/bin/shasum -a 256 "$archive" | cut -d' ' -f1)"
[ "$actual" = "$ARCHIVE_SHA256" ] || fail 'SHA-256 mismatch; nothing was installed.'
/usr/bin/tar -xzf "$archive" -C "$work"
source_root="$work/$PAYLOAD"
names=('SYS 01.app' 'SYS 01.vst3' 'SYS 01.component')
parents=("$prefix/Applications" "$prefix/Library/Audio/Plug-Ins/VST3" "$prefix/Library/Audio/Plug-Ins/Components")
for i in 0 1 2; do
    source="$source_root/binaries/${names[$i]}"
    [ -d "$source" ] || fail "Missing bundle: ${names[$i]}"
    /usr/bin/codesign --verify --deep --strict "$source"
    target="${parents[$i]}/${names[$i]}"
    [ ! -L "$target" ] || fail "Refusing to replace a symlink: $target"
    if [ -e "$target" ]; then
        identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$target/Contents/Info.plist" 2>/dev/null)" || fail "Unrecognized existing bundle: $target"
        [ "$identifier" = org.algorhythmia.sys01 ] || fail "Another product already uses $target"
    fi
    if [ "$dry_run" -eq 1 ]; then printf 'Verified: %s -> %s\n' "${names[$i]}" "$target"; fi
done
if [ "$dry_run" -eq 1 ]; then
    printf 'SYS 01 %s verified. No installation changes made.\n' "$TAG"
    exit 0
fi
printf 'Installing SYS 01 %s. Close SYS 01 and your DAW before updating.\n' "$TAG"
# Stage all bundles on their destination filesystems before replacing any version.
for i in 0 1 2; do
    mkdir -p "${parents[$i]}"
    stage="$(mktemp -d "${parents[$i]}/.sys01-stage.XXXXXX")"
    targets+=("${parents[$i]}/${names[$i]}")
    stages+=("$stage")
    backed_up+=(0)
    installed+=(0)
    /usr/bin/ditto "$source_root/binaries/${names[$i]}" "$stage/new"
    /usr/bin/codesign --verify --deep --strict "$stage/new"
done
for i in 0 1 2; do
    if [ -e "${targets[$i]}" ]; then
        mv "${targets[$i]}" "${stages[$i]}/previous"
        backed_up[$i]=1
    fi
    mv "${stages[$i]}/new" "${targets[$i]}"
    installed[$i]=1
    /usr/bin/codesign --verify --deep --strict "${targets[$i]}"
done
committed=1
printf '\nInstalled SYS 01 %s:\n' "$TAG"
printf '  %s\n' "${targets[@]}"
printf '\nOpen the app from your Applications folder, or rescan plugins in your DAW.\n'
printf 'Public beta: ad-hoc signed; not Apple-notarized. No security settings were changed.\n'
